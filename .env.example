VEYRO_MODE=rehearsal
# Required hosted store. Both values are server-only; never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Your exact generated Railway origin; no trailing slash.
VEYRO_APP_ORIGIN=
# Separate random strings of at least 32 characters. Never NEXT_PUBLIC_.
VEYRO_OPERATOR_TOKEN=
VEYRO_AGENT_TOKEN=
# Optional paid read-only X research; disabled without a token.
X_BEARER_TOKEN=
X_MAX_REQUESTS_PER_DAY=10
# Read-only mint verification of research candidates. Never used for signing.
SOLANA_MAINNET_READ_RPC_URL=https://api.mainnet-beta.solana.com
# Required only for VEYRO_MODE=testnet after the protocol is deployed.
SOLANA_RPC_URL=https://api.testnet.solana.com
VEYRO_DEPLOYMENT_FILE=/app/data/deployment.local.json
VEYRO_KEYS_DIR=/app/data/keys
