VEYRO_MODE=rehearsal
# Required hosted store. Both values are server-only; never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Your exact generated Railway origin; no trailing slash.
VEYRO_APP_ORIGIN=
# Separate random strings of at least 32 characters. Never NEXT_PUBLIC_.
VEYRO_OPERATOR_TOKEN=
VEYRO_AGENT_TOKEN=
# Used to encrypt admin credentials before writing them to Supabase.
VEYRO_CREDENTIALS_KEY=
# Optional fallback paid read-only X research; disabled without a token.
X_BEARER_TOKEN=
X_MAX_REQUESTS_PER_DAY=10
# Read-only mint verification of research candidates. Never used for signing.
SOLANA_MAINNET_READ_RPC_URL=https://api.mainnet-beta.solana.com
# Required only for VEYRO_MODE=testnet after the protocol is deployed.
SOLANA_RPC_URL=https://api.testnet.solana.com
VEYRO_DEPLOYMENT_FILE=/app/data/deployment.local.json
VEYRO_KEYS_DIR=/app/data/keys

# ---- Telegram trading bot ----
# From @BotFather. Server-only; never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Random string >=32 chars, passed to setWebhook as secret_token and checked
# against the X-Telegram-Bot-Api-Secret-Token header on every update.
TELEGRAM_WEBHOOK_SECRET=
# Hard off-switch for all mainnet spending. Trading is disabled unless "true".
VEYRO_TRADING_ENABLED=false
# Write-capable mainnet RPC used to send swaps. A public endpoint will be
# rate-limited; use a dedicated provider before real volume.
SOLANA_MAINNET_RPC_URL=
# Jupiter swap API. Key is optional on the free tier.
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
# Free PumpPortal launch feed consumed by the worker process.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Compiles a user's plain-English edge into a CompiledStrategy.
ANTHROPIC_API_KEY=
# Transcribes Telegram voice notes. Set this and voice works in the container;
# without it the bot falls back to a local whisper.cpp model, which only exists
# on a developer Mac, and otherwise says it cannot hear rather than ignoring.
OPENAI_API_KEY=
VEYRO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Execution guardrails applied to every swap.
VEYRO_MAX_SLIPPAGE_BPS=300
VEYRO_PRIORITY_FEE_LAMPORTS=200000
