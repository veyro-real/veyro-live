import test from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';
process.env.VEYRO_MODE='rehearsal';process.env.VEYRO_STORE='memory';
const {act,currentPolicy}=await import('../lib/engine');const {attempts,getState,saveState,recordAttempt,beginAttempt}=await import('../lib/store');const {authorize}=await import('../lib/auth');
const run=(session:string,body:Record<string,unknown>)=>act(session,{requestId:randomUUID(),intent:'Find a ridiculous meme coin',budget:'60',...body},true) as Promise<any>;
test('complete allowed, budget, recipient, compromise and revocation workflow',async()=>{const session=randomUUID();const allowed=await run(session,{action:'run'});assert.equal(allowed.attempt.decision,'ALLOW');assert.equal(allowed.attempt.status,'REHEARSED');assert.equal(allowed.attempt.executedSignature,undefined);assert.equal((await currentPolicy(session)).spent,'60000000');const over=await run(session,{action:'run',scenario:'over-limit'});assert.equal(over.attempt.reason,'MAX_TRANSACTION_EXCEEDED');const cumulative=await run(session,{action:'run',scenario:'cumulative'});assert.equal(cumulative.attempt.reason,'CUMULATIVE_LIMIT_EXCEEDED');for(const scenario of ['unauthorized','compromised']){const denied=await run(session,{action:'run',scenario});assert.equal(denied.attempt.reason,'RECIPIENT_NOT_ALLOWED');}await run(session,{action:'revoke'});const revoked=await run(session,{action:'run',budget:'1'});assert.equal(revoked.attempt.reason,'REVOKED');assert.equal((await currentPolicy(session)).spent,'60000000');assert.equal((await attempts(session)).length,7);});
test('request replay does not debit twice',async()=>{const session=randomUUID(),requestId=randomUUID();const b={action:'run',requestId,intent:'buy test token',budget:'10'};const a=await act(session,b,true) as any;const again=await act(session,b,true) as any;assert.equal(a.attempt.id,again.attempt.id);assert.equal((await currentPolicy(session)).spent,'10000000');assert.equal((await attempts(session)).length,1);});
test('paid research requires operator permission in public rehearsal',async()=>{const a=await act(randomUUID(),{action:'run',requestId:randomUUID(),intent:'find',budget:'1',liveResearch:true},false) as any;assert.equal(a.attempt.reason,'OPERATOR_REQUIRED_FOR_PAID_RESEARCH');});
test('audit strips transaction bytes and runtime secrets',async()=>{const s=randomUUID(),a=await beginAttempt(s,'test',{});a.wire='private-bytes';a.pendingRuntime={rpcUrl:'private-provider-url'};await recordAttempt(s,a);assert.equal((await attempts(s))[0].wire,undefined);assert.equal((await attempts(s))[0].pendingRuntime,undefined);assert.equal((await attempts(s,true))[0].wire,'private-bytes');});
test('testnet operator privileges are not granted to an agent token',()=>{process.env.VEYRO_MODE='testnet';process.env.VEYRO_OPERATOR_TOKEN='o'.repeat(40);process.env.VEYRO_AGENT_TOKEN='a'.repeat(40);const r=new Request('https://demo.example',{headers:{Authorization:'Bearer '+'a'.repeat(40)}});assert.equal(authorize(r).operator,false);assert.throws(()=>authorize(r,true),/UNAUTHORIZED/);process.env.VEYRO_MODE='rehearsal';});
test('invalid budget fails without spending or forged success',async()=>{const s=randomUUID(),r=await run(s,{action:'run',budget:'-100'});assert.equal(r.attempt.decision,'DENY');assert.equal(r.attempt.status,'FAILED');assert.equal((await currentPolicy(s)).spent,'0');});
